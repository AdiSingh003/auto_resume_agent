# Required: Get free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Optional fallback: Get free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Tavily search (https://tavily.com) - DuckDuckGo used if not set
TAVILY_API_KEY=

# Model config
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MODEL=gemini-2.0-flash

# Agent config
MAX_REVISION_CYCLES=3
ATS_SCORE_THRESHOLD=75
FORMATTING_SCORE_THRESHOLD=80
FACTUAL_SCORE_THRESHOLD=90
